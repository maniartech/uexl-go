    { "name": "trunc", "category": "math", "family": "math", "arity": {"min": 1, "max": 1}, "params": ["number"], "returns": "number", "onInvalid": "error", "pure": true, "profile": "stdlib", "status": "implemented", "impl": {"go": "builtins/numbers"} },
