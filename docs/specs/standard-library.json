{
  "$comment": "UExL standard-library manifest. Canonical, language-neutral inventory of built-in functions. The drift checker (cmd/builtins-check) compares this manifest against the live registry (the always-on core vm.Builtins plus every attachable standard-library family) and the books, and runs family-completeness rules. 'arity'/'params' are descriptive (not machine-enforced). 'profile': core = always available in vm.Builtins; stdlib = ships in the builtins/<family> packages, attached by the host via uexl.WithStdlib() or a per-family option (WithMath, WithStrings, ...). 'status': implemented = present in the registry; planned/gap/documented-only/deprecated as before. 'onInvalid': error = raises; null = returns null on bad input (the tryParseX/safe forms); mixed = some args error and some fall back. now()/today() are stdlib but clock-injected (need WithClock).",
  "version": "1.0",
  "builtins": [
    { "name": "len", "category": "collection", "family": "length", "arity": {"min": 1, "max": 1}, "params": ["string|array"], "returns": "number", "onInvalid": "error", "pure": true, "profile": "core", "status": "implemented", "impl": {"go": "vm.builtinLen"} },
