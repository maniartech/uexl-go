    { "name": "sum", "category": "math", "family": "math", "arity": {"min": 0, "max": 99}, "params": ["array<number>|number..."], "returns": "number", "onInvalid": "error", "pure": true, "profile": "stdlib", "status": "implemented", "impl": {"go": "builtins/numbers"}, "notes": "Accepts a single array or several numeric arguments; an empty call returns 0." },
    { "name": "avg", "category": "math", "family": "math", "arity": {"min": 1, "max": 99}, "params": ["array<number>|number..."], "returns": "number", "onInvalid": "error", "pure": true, "profile": "stdlib", "status": "implemented", "impl": {"go": "builtins/numbers"}, "notes": "Accepts a single array or several numeric arguments; needs at least one number." },
