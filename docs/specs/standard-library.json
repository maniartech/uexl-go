    { "name": "pow", "category": "math", "family": "math", "arity": {"min": 2, "max": 2}, "params": ["number", "number"], "returns": "number", "onInvalid": "error", "pure": true, "profile": "stdlib", "status": "implemented", "impl": {"go": "builtins/numbers"} },
    { "name": "clamp", "category": "math", "family": "math", "arity": {"min": 3, "max": 3}, "params": ["number", "number", "number"], "returns": "number", "onInvalid": "error", "pure": true, "profile": "stdlib", "status": "implemented", "impl": {"go": "builtins/numbers"}, "notes": "Errors if the lower bound exceeds the upper bound." },

    { "name": "parseNum", "category": "conversion", "family": "conversion-number", "arity": {"min": 1, "max": 1}, "params": ["string"], "returns": "number", "onInvalid": "error", "pure": true, "profile": "stdlib", "status": "implemented", "impl": {"go": "builtins/conversion"} },
