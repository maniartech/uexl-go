    { "name": "graphemes", "category": "unicode", "family": "explode-reassemble", "arity": {"min": 1, "max": 1}, "params": ["string"], "returns": "array", "onInvalid": "error", "pure": true, "profile": "core", "status": "implemented", "impl": {"go": "vm.builtinGraphemes"} },
