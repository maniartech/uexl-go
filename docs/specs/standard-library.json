    { "name": "set", "category": "collection", "family": "collection", "arity": {"min": 3, "max": 3}, "params": ["object", "string|number", "any"], "returns": "object", "onInvalid": "error", "pure": false, "profile": "core", "status": "implemented", "impl": {"go": "vm.builtinSet"}, "notes": "Mutates the input object in place and returns it (NOT copy-returning); clone in Go first if you need immutability. The pure collection helpers remove/merge are the copy-returning alternatives." },
    { "name": "str", "category": "conversion", "family": "conversion", "arity": {"min": 1, "max": 1}, "params": ["any"], "returns": "string", "onInvalid": "error", "pure": true, "profile": "core", "status": "implemented", "impl": {"go": "vm.builtinStr"}, "notes": "Go fmt %v stringify; str(null) is \"<nil>\"." },
    { "name": "runeLen", "category": "unicode", "family": "length", "arity": {"min": 1, "max": 1}, "params": ["string"], "returns": "number", "onInvalid": "error", "pure": true, "profile": "core", "status": "implemented", "impl": {"go": "vm.builtinRuneLen"} },
    { "name": "runeSubstr", "category": "unicode", "family": "substring", "arity": {"min": 3, "max": 3}, "params": ["string", "number", "number"], "returns": "string", "onInvalid": "error", "pure": true, "profile": "core", "status": "implemented", "impl": {"go": "vm.builtinRuneSubstr"} },
    { "name": "graphemeLen", "category": "unicode", "family": "length", "arity": {"min": 1, "max": 1}, "params": ["string"], "returns": "number", "onInvalid": "error", "pure": true, "profile": "core", "status": "implemented", "impl": {"go": "vm.builtinGraphemeLen"} },
    { "name": "graphemeSubstr", "category": "unicode", "family": "substring", "arity": {"min": 3, "max": 3}, "params": ["string", "number", "number"], "returns": "string", "onInvalid": "error", "pure": true, "profile": "core", "status": "implemented", "impl": {"go": "vm.builtinGraphemeSubstr"} },
